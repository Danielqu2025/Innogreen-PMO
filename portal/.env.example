# =============================================
# Innogreen IAM Portal 环境变量配置
# 复制此文件为 .env 并修改实际值
# =============================================

# 会话签名密钥（必填；与 PMO / qcc 共用同一密钥，实现跨应用 cookie 互信）
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-output-of-secrets-token-hex-32

# 会话 cookie（三端同名；同域路径 SSO 时 Domain 留空）
SESSION_COOKIE_NAME=innogreen_session
SESSION_COOKIE_DOMAIN=
# 生产 HTTPS 反代 / Tunnel 后设 true
HTTPS_ONLY=false

# Portal 数据库路径
PORTAL_DB_PATH=./data/portal.db

# 信任的应用列表（逗号分隔）
TRUSTED_APPS=PMO,qcc,sh_eia

# CORS 允许的前端地址（同域路径部署时可只留公网 origin）
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8765,http://localhost:8080,http://localhost:8001

# 冷启动管理员（可选，首次启动时生效；自动授予 PMO/qcc/sh_eia admin）
PORTAL_BOOTSTRAP_ADMIN_USERNAME=admin
PORTAL_BOOTSTRAP_ADMIN_PASSWORD=change-me-now

# Portal 服务地址（内部）
PORTAL_BASE_URL=http://localhost:8001

# 同域路径部署时写入应用目录的公网入口（仅新增应用时 seed；已有记录不覆盖）
# PMO_PUBLIC_URL=https://innogreen.example.com/pmo/
# QCC_PUBLIC_URL=https://innogreen.example.com/qcc/
# SH_EIA_PUBLIC_URL=https://innogreen.example.com/eia/

# 可选：合并迁移默认源库路径（脚本也可用 CLI 覆盖）
# PMO_USERS_DB_PATH=../data/innogreen_pmo.db
# QCC_USERS_DB_PATH=D:/Claude/qcc/data/qualifications.db
# SH_EIA_USERS_DB_PATH=D:/github/Scrapling/examples/sh_eia/data/auth.db
